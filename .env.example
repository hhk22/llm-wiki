# Google AI Studio에서 발급한 API 키를 입력한다.
GEMINI_API_KEY=require-your-api-key
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# Wiki 질의는 기본적으로 프로젝트의 wiki/, sources/를 읽는다.
# 별도 구축 결과를 사용할 때만 두 경로를 함께 지정한다.
# LLM_WIKI_DIR=C:/path/to/llm-wiki/wiki-new
# LLM_WIKI_SOURCES=C:/path/to/llm-wiki/sources

# Docker Compose와 로컬 색인 작업에서 사용한다.
POSTGRES_DB=llm_wiki
POSTGRES_USER=llm_wiki
POSTGRES_PASSWORD=llm_wiki
POSTGRES_PORT=5432
DATABASE_URL=postgresql://llm_wiki:llm_wiki@127.0.0.1:5432/llm_wiki

# 로컬 API 실행 주소. Compose 내부에서는 0.0.0.0으로 설정한다.
API_HOST=127.0.0.1
# Compose에서 호스트에 공개하는 API·MCP 포트.
API_PORT=8000
MCP_PORT=8001
# 로컬 stdio MCP의 API 주소. Compose 내부에서는 http://api:8000을 사용한다.
LLM_WIKI_API_URL=http://127.0.0.1:8000
