# Google AI Studio에서 발급한 API 키를 입력한다.
GEMINI_API_KEY=require-your-api-key
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# Docker Compose와 로컬 색인 작업에서 사용한다.
POSTGRES_DB=llm_wiki
POSTGRES_USER=llm_wiki
POSTGRES_PASSWORD=llm_wiki
POSTGRES_PORT=5432
DATABASE_URL=postgresql://llm_wiki:llm_wiki@127.0.0.1:5432/llm_wiki

# API와 MCP 연결에 사용한다.
API_HOST=127.0.0.1
API_PORT=8000
LLM_WIKI_API_URL=http://127.0.0.1:8000
